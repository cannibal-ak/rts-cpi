# =============================================================================
# RTS CPI — Environment Variables
# Copy this file to .env and fill in real values before running the stack.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE — PostgreSQL 16 (shared system-of-record)
# ---------------------------------------------------------------------------
# Superuser credentials for the CPI database
POSTGRES_USER=cpi
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=cpi_db

# ---------------------------------------------------------------------------
# DATABASE — API connections
# ---------------------------------------------------------------------------
# Superuser connection string (used for running Alembic migrations)
CPI_DATABASE_URL=postgresql://cpi:your-postgres-password-here@postgres:5432/cpi_db

# ---------------------------------------------------------------------------
# RLS — Row-Level Security enforced connection
# ---------------------------------------------------------------------------
# Restricted-privilege user created by migration 002; all tenant-scoped
# queries route through this connection to enforce RLS policies.
CPI_DATABASE_URL_RLS=postgresql://cpi_app:your-rls-user-password-here@postgres:5432/cpi_db

# ---------------------------------------------------------------------------
# TENANT — Default tenant for local development
# ---------------------------------------------------------------------------
# UUID of the seed tenant (Acme Airways in local dev)
CPI_DEFAULT_TENANT_ID=a0000000-0000-0000-0000-000000000001

# ---------------------------------------------------------------------------
# MESSAGING — RabbitMQ
# ---------------------------------------------------------------------------
# AMQP connection string for async job queue (ingestion, notifications)
CPI_RABBITMQ_URL=amqp://guest:your-rabbitmq-password-here@rabbitmq:5672/

# ---------------------------------------------------------------------------
# CACHE — Redis
# ---------------------------------------------------------------------------
# Redis connection for caching, session store, rate limiting
CPI_REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# SUPERSET — Apache Superset embedded analytics
# ---------------------------------------------------------------------------
# Flask secret key for Superset (generate a strong random string in prod)
SUPERSET_SECRET_KEY=change-me-in-production
# Superset admin credentials (change in production)
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASS=change-me-in-production

# ---------------------------------------------------------------------------
# FRONTEND — React / Vite
# ---------------------------------------------------------------------------
# Base URL for the FastAPI backend (adjust IP/port for your environment)
VITE_API_BASE_URL=http://localhost:8000
# Tenant ID the frontend operates under
VITE_TENANT_ID=a0000000-0000-0000-0000-000000000001
# Comma-separated list of available RBAC roles
VITE_USER_ROLES=TENANT_ADMIN,DATA_ENGINEER,ANALYST,AUDITOR

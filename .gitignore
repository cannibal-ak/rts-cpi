# =============================================================================
# RTS CPI — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.cover

# ---------------------------------------------------------------------------
# Node / Frontend
# ---------------------------------------------------------------------------
node_modules/
apps/web/dist/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Environment & Secrets (NEVER commit)
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
credentials.json

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
.claude/

# ---------------------------------------------------------------------------
# IDE & OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml

# ---------------------------------------------------------------------------
# Project-specific: debug artifacts & temp files
# ---------------------------------------------------------------------------
tmp/
*.bak
*.bak-*
*.bak.*
*.tmp

# Data files (keep folder structure via .gitkeep)
# Case-insensitive on extensions because uppercase .CSV / .XLSX have
# leaked through case-sensitive matches before.
apps/api/data/**/*.[Cc][Ss][Vv]
apps/api/data/**/*.[Xx][Ll][Ss][Xx]
apps/api/data/**/*.[Jj][Ss][Oo][Nn]
# Ingestion staging — UUID-named per-run subdirs, never to be committed.
apps/api/data/staging/
!apps/api/data/.gitkeep

# Loose debug/log files in project root
alembic_error*.txt
api-logs*.txt
api_logs*.txt
error*.txt
error_log.txt
seed_error.txt
seed_log.txt
containers.txt
tables.txt
temp_logs.txt
superset_dashboards.txt
superset_ids.txt
superset_logs.txt
fjl_headers_list.txt
jy_header*.txt
jy_headers_list.txt
jy_row_*.txt
debug_layout.js

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/

# ---------------------------------------------------------------------------
# Database dumps & backups
# ---------------------------------------------------------------------------
*.sql.gz
*.dump
backups/

# Phase 2 SFTP — dev-only mount points (real files never committed)
dev-sftp-mount/jy/*
dev-sftp-mount/pw/*
!dev-sftp-mount/jy/.gitkeep
!dev-sftp-mount/pw/.gitkeep

# Backup files (underscore-suffixed, e.g. .bak_pre_pw)
*.bak_*

# Dated backup JSON dumps (e.g. fjl_dash2_filters_backup_20260526_124204.json)
*_backup_*.json

# ---------------------------------------------------------------------------
# IT handoff cleanup additions (2026-05-25)
# ---------------------------------------------------------------------------
*.orig
*.save
*.tgz
*.db.bak*
.env.prod
.env.host-ref
cpi_deploy_bundle_*.tar.gz
superset_backups/
_restore/
*.tar.gz

# DreamAir demo build artefacts (regenerate with scripts/relabel_pw_files_as_da.py)
apps/api/data/da_demo/

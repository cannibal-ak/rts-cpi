# =============================================================================
# RTS CPI — Git Attributes
# =============================================================================

# Normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf

# Binary files — do not diff or merge
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.xlsx binary
*.xls binary
*.csv binary
*.pdf binary
*.docx binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
